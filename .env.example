# Porta em que o servidor vai rodar
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Segredo usado para assinar os tokens JWT.
# Gere um valor proprio e secreto, por exemplo: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Tempo de expiracao do token JWT
JWT_EXPIRES_IN=1d
