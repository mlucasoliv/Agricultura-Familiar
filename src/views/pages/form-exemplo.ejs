<%- include('../partials/header') %>
<section class="form-card form-example">
  <p class="form-kicker">Referência visual</p>
  <h1>Referência de Formulário</h1>
  <p class="form-intro">
    Use estas classes como base para login, cadastro, produtos e demais formulários da AgroFamília.
  </p>

  <form class="form-agro" onsubmit="return false;">
    <div class="form-grupo">
      <label for="nome">Nome do produto</label>
      <input type="text" id="nome" name="nome" placeholder="Ex: Mel Silvestre 500g" autocomplete="off">
      <span class="form-dica">Use um nome claro e descritivo.</span>
    </div>

    <div class="form-grupo">
      <label for="preco">Preço (R$)</label>
      <input type="number" id="preco" name="preco" placeholder="0,00" step="0.01" min="0" inputmode="decimal">
    </div>

    <div class="form-grupo">
      <label for="categoria">Categoria</label>
      <select id="categoria" name="categoria">
        <option value="">Selecione...</option>
        <option>Mel e derivados</option>
        <option>Laticínios</option>
        <option>Grãos e farinhas</option>
        <option>Bebidas artesanais</option>
        <option>Doces e conservas</option>
      </select>
    </div>

    <div class="form-grupo">
      <label for="descricao">Descrição</label>
      <textarea id="descricao" name="descricao" placeholder="Descreva o produto, origem, modo de preparo..."></textarea>
    </div>

    <div class="form-grupo">
      <label for="erro-exemplo">Campo com erro (exemplo)</label>
      <input class="campo-erro" type="text" id="erro-exemplo" name="erroExemplo" value="dado inválido" aria-describedby="erro-exemplo-msg">
      <span id="erro-exemplo-msg" class="form-erro">Este campo contém um valor inválido.</span>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-agro">Salvar produto</button>
      <button type="button" class="btn-agro-outline">Cancelar</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
