<%- include('partials/header') %>
<section class="form-card">
  <p class="form-kicker">Acesso seguro</p>
  <h1>Entrar na AgroFamília</h1>
  <% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
  <form action="/login" method="POST">
    <label>E-mail
      <input type="email" name="email" value="<%= dados.email || '' %>" autocomplete="email" required />
    </label>
    <label>Senha
      <input type="password" name="senha" autocomplete="current-password" required />
    </label>
    <button type="submit" class="btn-agro">Entrar no painel</button>
  </form>
  <p class="alt">Ainda não tem conta? <a href="/cadastro">Criar conta grátis</a></p>
</section>
<%- include('partials/footer') %>
