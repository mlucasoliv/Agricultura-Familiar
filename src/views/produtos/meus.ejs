<%- include('../partials/header') %>
<section class="produtos">
  <div class="produtos-topo">
    <h1>Meus produtos</h1>
    <a class="botao" href="/produtos/novo">+ Novo produto</a>
  </div>

  <% if (produtos.length === 0) { %>
    <p class="aviso">Voce ainda nao cadastrou produtos.</p>
  <% } else { %>
    <div class="table-responsive mt-2">
      <table class="tabela tabela-compacta">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Preco</th>
            <th>Unidade</th>
            <th>Status</th>
            <th>Acoes</th>
          </tr>
        </thead>
        <tbody>
          <% produtos.forEach(function (p) { %>
            <tr>
              <td><%= p.nome %></td>
              <td>R$ <%= Number(p.preco).toFixed(2) %></td>
              <td><%= p.unidade %></td>
              <td><%= p.disponivel ? 'Disponivel' : 'Indisponivel' %></td>
              <td class="acoes-tabela">
                <a href="/produtos/<%= p.id %>/editar">Editar</a>
                <form action="/produtos/<%= p.id %>/excluir" method="POST" class="inline"
                      onsubmit="return confirm('Remover este produto?');">
                  <button type="submit" class="link perigo">Excluir</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
