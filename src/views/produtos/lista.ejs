<%- include('../partials/header') %>
<section class="produtos">
  <div class="produtos-topo">
    <div>
      <p class="form-kicker">Catalogo local</p>
      <h1>Produtos</h1>
    </div>
    <% if (usuario && usuario.tipo === 'produtor') { %>
      <div class="produtos-topo__acoes">
        <a class="btn-agro-outline" href="/produtos/meus">Gerenciar produtos</a>
        <a class="btn-agro" href="/produtos/novo">+ Novo produto</a>
      </div>
    <% } %>
  </div>

  <form class="busca" action="/produtos" method="GET">
    <input type="search" name="q" placeholder="Buscar por nome..." value="<%= busca %>" />
    <button type="submit" class="btn-agro-outline">Buscar</button>
    <% if (busca) { %><a class="alt" href="/produtos">Limpar</a><% } %>
  </form>

  <% if (produtos.length === 0) { %>
    <p class="aviso">
      <% if (busca) { %>Nenhum produto encontrado para "<%= busca %>".<% } else { %>Nenhum produto cadastrado ainda.<% } %>
    </p>
  <% } else { %>
    <ul class="cards">
      <% produtos.forEach(function (p) { %>
        <li class="card<%= p.disponivel ? '' : ' indisponivel' %>">
          <div class="card__media">
            <% if (p.imagemUrl) { %>
              <img src="<%= p.imagemUrl %>" alt="<%= p.nome %>">
            <% } else { %>
              <img src="/img/produto-default.svg" alt="Imagem padrao do produto">
            <% } %>
          </div>
          <div class="card__body">
            <span class="tag <%= p.disponivel ? 'tag-disponivel' : 'tag-indisponivel' %>"><%= p.disponivel ? 'Disponivel' : 'Indisponivel' %></span>
            <h2><a href="/produtos/<%= p.id %>"><%= p.nome %></a></h2>
            <p class="produtor">Por <%= p.dono ? p.dono.nome : 'produtor desconhecido' %></p>
            <% if (p.descricao) { %><p class="desc"><%= p.descricao %></p><% } %>
          </div>
          <div class="card__footer">
            <p class="preco"><%= Number(p.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %> <span>/ <%= p.unidade %></span></p>
            <a class="btn-agro-outline" href="/produtos/<%= p.id %>">Ver produto</a>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('../partials/footer') %>
