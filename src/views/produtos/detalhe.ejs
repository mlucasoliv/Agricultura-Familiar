<%- include('../partials/header') %>
<section class="produto-detalhe">
  <div class="produto-detalhe__media">
    <% if (produto.imagemUrl) { %>
      <img src="<%= produto.imagemUrl %>" alt="<%= produto.nome %>">
    <% } else { %>
      <img src="/img/produto-default.svg" alt="Imagem padrao do produto">
    <% } %>
  </div>

  <div class="produto-detalhe__info">
    <span class="tag <%= produto.disponivel ? 'tag-disponivel' : 'tag-indisponivel' %>"><%= produto.disponivel ? 'Disponivel' : 'Indisponivel' %></span>
    <h1><%= produto.nome %></h1>
    <p class="preco"><strong><%= Number(produto.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong> / <%= produto.unidade %></p>
    <% if (produto.descricao) { %>
      <p class="desc"><%= produto.descricao %></p>
    <% } %>

    <div class="produtor-box">
      <img src="/img/produto-default.svg" alt="Imagem padrao do produto">
      <strong><%= produto.dono ? produto.dono.nome : 'Produtor desconhecido' %></strong>
      <p>Agricultura familiar local com venda direta pela AgroFamilia.</p>
    </div>

    <% if (produto.disponivel && usuario && usuario.tipo !== 'produtor') { %>
      <form class="pedido-rapido" action="/pedidos" method="POST">
        <input type="hidden" name="produtoId" value="<%= produto.id %>">
        <label>
          Quantidade
          <input type="number" name="quantidade" value="1" min="1" inputmode="numeric">
        </label>
        <button class="btn-agro" type="submit">Fazer pedido</button>
      </form>
    <% } else if (produto.disponivel && !usuario) { %>
      <a class="btn-agro" href="/login">Entrar para pedir</a>
    <% } else if (!produto.disponivel) { %>
      <p class="erro">Produto indisponivel no momento.</p>
    <% } %>

    <% if (usuario && usuario.tipo === 'produtor' && produto.usuarioId === usuario.id) { %>
      <a class="btn-agro-outline" href="/produtos/<%= produto.id %>/editar">Editar produto</a>
    <% } %>

    <p class="alt"><a href="/produtos">&larr; Voltar aos produtos</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
