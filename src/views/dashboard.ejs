<%- include('partials/header') %>
<%
  const tituloCatalogo = isProdutor ? 'Meus produtos recentes' : 'Produtos recentes no catálogo';
  const subtitulo = isProdutor
    ? `Sua vitrine tem ${meusProdutos} produto${meusProdutos === 1 ? '' : 's'}, com ${meusDisponiveis} disponíve${meusDisponiveis === 1 ? 'l' : 'is'} para consulta.`
    : `Encontre produtos disponíveis de ${totalProdutores} produtor${totalProdutores === 1 ? '' : 'es'} da agricultura familiar.`;
%>

<section class="dashboard-hero">
  <div>
    <p class="form-kicker">Central AgroFamília</p>
    <h2><%= isProdutor ? 'Sua vitrine no campo' : 'Catálogo da agricultura familiar' %></h2>
    <p><%= subtitulo %></p>
  </div>

  <div class="dashboard-actions">
    <% if (isProdutor) { %>
      <a class="btn-agro" href="/produtos/novo">Cadastrar novo produto</a>
      <a class="btn-agro-outline" href="/produtos/meus">Gerenciar meus produtos</a>
    <% } else { %>
      <a class="btn-agro" href="/produtos">Ver produtos disponíveis</a>
    <% } %>
  </div>
</section>

<div class="row g-3 mb-4">
  <% if (isProdutor) { %>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">Meus produtos</div>
          <div class="card-valor"><%= meusProdutos %></div>
        </div>
        <div class="card-icone">📦</div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">Disponíveis</div>
          <div class="card-valor"><%= meusDisponiveis %></div>
        </div>
        <div class="card-icone">🌿</div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">Indisponíveis</div>
          <div class="card-valor"><%= meusIndisponiveis %></div>
        </div>
        <div class="card-icone">⏸️</div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">No catálogo</div>
          <div class="card-valor"><%= totalProdutos %></div>
        </div>
        <div class="card-icone">🧺</div>
      </div>
    </div>
  <% } else { %>
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">Produtos disponíveis</div>
          <div class="card-valor"><%= totalDisponiveis %></div>
        </div>
        <div class="card-icone">🌿</div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">Produtos cadastrados</div>
          <div class="card-valor"><%= totalProdutos %></div>
        </div>
        <div class="card-icone">📦</div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
      <div class="card-resumo d-flex justify-content-between align-items-center">
        <div>
          <div class="card-label">Produtores</div>
          <div class="card-valor"><%= totalProdutores %></div>
        </div>
        <div class="card-icone">🧑‍🌾</div>
      </div>
    </div>
  <% } %>
</div>

<section class="dashboard-section">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
    <div>
      <span class="secao-titulo">🧺 <%= tituloCatalogo %></span>
      <p class="dashboard-section__hint">
        <%= isProdutor ? 'Acompanhe os últimos itens cadastrados na sua vitrine.' : 'Veja produtos disponíveis adicionados recentemente.' %>
      </p>
    </div>
  </div>

  <% if (produtosRecentes.length) { %>
    <div class="table-responsive">
      <table class="tabela-agro">
        <thead>
          <tr>
            <th>Produto</th>
            <th>Produtor</th>
            <th>Preço / unidade</th>
            <th>Status</th>
            <th>Cadastro</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody>
          <% produtosRecentes.forEach((produto) => { %>
            <tr>
              <td><%= produto.nome %></td>
              <td><%= produto.dono ? produto.dono.nome : usuario.nome %></td>
              <td><strong>R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></strong> / <%= produto.unidade %></td>
              <td>
                <% if (produto.disponivel) { %>
                  <span class="badge-status badge-concluido">Disponível</span>
                <% } else { %>
                  <span class="badge-status badge-cancelado">Indisponível</span>
                <% } %>
              </td>
              <td><%= produto.createdAt ? produto.createdAt.toLocaleDateString('pt-BR') : '-' %></td>
              <td>
                <% if (isProdutor) { %>
                  <a href="/produtos/<%= produto.id %>/editar">Editar</a>
                <% } else { %>
                  <a href="/produtos/<%= produto.id %>">Ver produto</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <strong><%= isProdutor ? 'Sua vitrine ainda está vazia.' : 'Nenhum produto disponível no momento.' %></strong>
      <p><%= isProdutor ? 'Cadastre o primeiro produto para começar a montar seu catálogo.' : 'Volte em breve para conferir novas ofertas de produtores locais.' %></p>
      <% if (isProdutor) { %>
        <a class="btn-agro" href="/produtos/novo">Cadastrar primeiro produto</a>
      <% } else { %>
        <a class="btn-agro-outline" href="/produtos">Ir para produtos</a>
      <% } %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
