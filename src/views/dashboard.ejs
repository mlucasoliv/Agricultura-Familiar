<%- include('partials/header') %>

<div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
  <div>
    <p class="form-kicker">Área protegida</p>
    <h2 class="mb-2">Painel Geral</h2>
    <p class="text-muted mb-0">Olá, <strong><%= usuario.nome %></strong>. Acompanhe os principais números da AgroFamília.</p>
  </div>

  <% if (usuario.tipo === 'produtor') { %>
    <div class="align-self-lg-end">
      <a class="btn-agro" href="/produtos/meus">Gerenciar meus produtos</a>
    </div>
  <% } %>
</div>

<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Produtores</div>
        <div class="card-valor"><%= totalProdutores %></div>
      </div>
      <div class="card-icone">🧑‍🌾</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Produtos Cadastrados</div>
        <div class="card-valor"><%= totalProdutos %></div>
      </div>
      <div class="card-icone">📦</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Vendas este mês</div>
        <div class="card-valor" style="font-size: 1.4rem;"><%= vendasMes %></div>
      </div>
      <div class="card-icone">💰</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Pedidos Pendentes</div>
        <div class="card-valor"><%= pedidosPendentes %></div>
      </div>
      <div class="card-icone">🛒</div>
    </div>
  </div>
</div>

<!-- Próximas seções virão nos commits seguintes -->

<%- include('partials/footer') %>
