<%- include('partials/header') %>

<h2 class="mb-4">Painel Geral</h2>

<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Produtores</div>
        <div class="card-valor"><%= totalProdutores %></div>
      </div>
      <div class="card-icone">🧑‍🌾</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Produtos Cadastrados</div>
        <div class="card-valor"><%= totalProdutos %></div>
      </div>
      <div class="card-icone">📦</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Vendas este mês</div>
        <div class="card-valor" style="font-size: 1.4rem;"><%= vendasMes %></div>
      </div>
      <div class="card-icone">💰</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card-resumo d-flex justify-content-between align-items-center">
      <div>
        <div class="card-label">Pedidos Pendentes</div>
        <div class="card-valor"><%= pedidosPendentes %></div>
      </div>
      <div class="card-icone">🛒</div>
    </div>
  </div>
</div>

<!-- Próximas seções virão nos commits seguintes -->

<%- include('partials/footer') %>
