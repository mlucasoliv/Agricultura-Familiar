<%
  const currentPage = typeof activePage !== 'undefined' ? activePage : '';
  const loggedUser = typeof usuario !== 'undefined' ? usuario : null;
%>

<nav class="navbar navbar-expand-md navbar-dark sticky-top navbar-agro">
  <div class="container-fluid">
    <a class="navbar-brand fw-semibold" href="/">🌱 AgroFamília</a>

    <% if (loggedUser) { %>
      <button id="btn-sidebar-toggle" class="btn btn-sm btn-outline-light d-md-none me-2" type="button" aria-label="Abrir menu lateral">☰</button>
    <% } %>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarAgroFamilia"
      aria-controls="navbarAgroFamilia"
      aria-expanded="false"
      aria-label="Alternar navegação"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarAgroFamilia">
      <ul class="navbar-nav ms-auto mb-2 mb-md-0">
        <li class="nav-item">
          <a class="nav-link <%= currentPage === 'inicio' ? 'active' : '' %>" href="/" <%= currentPage === 'inicio' ? 'aria-current="page"' : '' %>>Início</a>
        </li>
        <% if (loggedUser) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>" href="/dashboard" <%= currentPage === 'dashboard' ? 'aria-current="page"' : '' %>>Painel</a>
          </li>
        <% } %>
      </ul>

      <div class="navbar-actions d-flex align-items-md-center gap-2 ms-md-3 mt-3 mt-md-0">
        <% if (loggedUser) { %>
          <span class="navbar-text">Olá, <%= loggedUser.nome %></span>
          <form action="/logout" method="POST" class="m-0">
            <button class="btn btn-outline-light btn-sm" type="submit">Sair</button>
          </form>
        <% } else { %>
          <a class="btn btn-outline-light btn-sm <%= currentPage === 'login' ? 'active' : '' %>" href="/login" <%= currentPage === 'login' ? 'aria-current="page"' : '' %>>Entrar</a>
          <a class="btn btn-light btn-sm <%= currentPage === 'cadastro' ? 'active' : '' %>" href="/cadastro" <%= currentPage === 'cadastro' ? 'aria-current="page"' : '' %>>Criar conta</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
